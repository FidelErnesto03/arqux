+"""The 20 architectural invariants of ArqUX 0.8 (spec §33).
+
+Each invariant is a numbered test file in this directory:
+
+    test_invariant_01_*.py
+    test_invariant_02_*.py
+    ...
+    test_invariant_20_*.py
+
+These tests are the **Definition of Done** for the 0.8 architecture.
+The build is green only when all 20 pass. Tests can be skipped while
+the implementing phase is not yet complete, but the skip is loud
+(uses ``pytest.mark.xfail(strict=True)`` or ``pytest.skip(reason)``)
+so progress is visible.
+
+Naming convention:
+    test_invariant_NN_short_slug.py
+
+    e.g. test_invariant_02_capability_never_implies_authority.py
+
+Invariants already implemented in this commit:
+    02 — capability does not imply authority (Phase 4 Authority stub)
+    10 — domain does not need to touch kernel (Phase 9 SPI)
+    12 — contract freeze hash is canonical (Phase 2 Contract Engine)
+
+The rest are scaffolded with explicit skip reasons pointing to the
+phase that will implement them.
+"""
diff --git a/tests/invariants/test_arch_dependencies.py b/tests/invariants/test_arch_dependencies.py
new file mode 100644
index 0000000..c80f0fb
--- /dev/null
+++ b/tests/invariants/test_arch_dependencies.py
@@ -0,0 +1,132 @@
+"""Architecture test: enforce ADR-001 dependency rules.
+
+Run as a pytest suite — fails the build when the kernel imports a
+domain module, or when a domain module imports kernel internals
+that are not part of the published API.
+
+Rules (ADR-001):
+
+    arqux.kernel           → no arqux.domains.*
+    arqux.kernel           → no arqux.handlers.*  (legacy 0.7 handlers
+                              remain a domain concern until migrated)
+    arqux.kernel           → no arqux.skills.*
+    arqux.spi              → no arqux.domains.*
+    arqux.domains.*        → no arqux.kernel internals prefixed with _
+    arqux.domains.*        → may import arqux.kernel + arqux.spi
+"""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+SRC = ROOT / "src" / "arqux"
+
+
+def _walk_py(pkg_dir: Path):
+    for py in pkg_dir.rglob("*.py"):
+        if "__pycache__" in py.parts:
+            continue
+        yield py
+
+
+def _imports_in(py_path: Path) -> list[tuple[int, str, str]]:
+    """Return (line, kind, target) for every import statement."""
+    tree = ast.parse(py_path.read_text(encoding="utf-8"))
+    out: list[tuple[int, str, str]] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom):
+            if node.module:
+                for alias in node.names:
+                    out.append((node.lineno, "from", f"{node.module}.{alias.name}"))
+                out.append((node.lineno, "from", node.module))
+        elif isinstance(node, ast.Import):
+            for alias in node.names:
+                out.append((node.lineno, "import", alias.name))
+    return out
+
+
+def _assert_no_imports(pkg: str, forbidden_prefixes: tuple[str, ...]) -> None:
+    pkg_dir = SRC / pkg
+    assert pkg_dir.is_dir(), f"missing {pkg_dir}"
+    offenders: list[str] = []
+    for py in _walk_py(pkg_dir):
+        for ln, kind, target in _imports_in(py):
+            for bad in forbidden_prefixes:
+                if target == bad or target.startswith(bad + "."):
+                    offenders.append(f"{py.relative_to(ROOT)}:{ln}: {kind} {target}")
+    assert not offenders, (
+        f"{pkg} has forbidden imports ({forbidden_prefixes}):\n" + "\n".join(offenders)
+    )
+
+
+def test_kernel_does_not_import_domains():
+    _assert_no_imports("kernel", ("arqux.domains",))
+
+
+def test_kernel_does_not_import_handlers():
+    """Handlers are 0.7 glue — must be migrated to domain packs
+    before the kernel can touch them. Until then, kernel stays clean.
+    """
+    _assert_no_imports("kernel", ("arqux.handlers",))
+
+
+def test_kernel_does_not_import_skills():
+    _assert_no_imports("kernel", ("arqux.skills",))
+
+
+def test_spi_does_not_import_domains():
+    _assert_no_imports("spi", ("arqux.domains",))
+
+
+def test_domains_do_not_import_kernel_internals():
+    """Domains may import arqux.kernel (public API) but never
+    arqux.kernel._private modules.
+    """
+    offenders: list[str] = []
+    for py in _walk_py(SRC / "domains"):
+        for ln, kind, target in _imports_in(py):
+            # Internal submodules of arqux.kernel — those are prefixed
+            # with _ and the public API never re-exports them.
+            if target.startswith("arqux.kernel._"):
+                offenders.append(
+                    f"{py.relative_to(ROOT)}:{ln}: {kind} {target} (kernel internal)"
+                )
+    assert not offenders, (
+        "domains must not import kernel internals (underscore-prefixed):\n"
+        + "\n".join(offenders)
+    )
+
+
+@pytest.mark.parametrize(
+    "module_path,reason",
+    [
+        ("arqux.kernel", "kernel surface is importable"),
+        ("arqux.kernel.space", "GovernedSpace is importable"),
+        ("arqux.kernel.activity", "Activity is importable"),
+        ("arqux.kernel.task", "Task is importable"),
+        ("arqux.kernel.contract", "ContractModel is importable"),
+        ("arqux.spi", "SPI manifest is importable"),
+        ("arqux.domains.software", "software pack is importable"),
+        ("arqux.domains.software.manifest", "software manifest exposed"),
+        ("arqux.domains.procurement", "procurement pack is importable"),
+        ("arqux.domains.procurement.manifest", "procurement manifest exposed"),
+        ("arqux.domains.software.cortex_schema", "cortex schema exposed"),
+    ],
+)
+def test_imports(module_path: str, reason: str) -> None:
+    import importlib
+
+    try:
+        importlib.import_module(module_path)
+    except ImportError as exc:
+        pytest.fail(f"failed to import {module_path} ({reason}): {exc}")
+    except Exception as exc:  # noqa: BLE001
+        # dataclass post_init errors are ok for empty constructor —
+        # we only want import to succeed.
+        if "post_init" in str(exc).lower():
+            return
+        pytest.fail(f"unexpected error importing {module_path}: {exc}")
