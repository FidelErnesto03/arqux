diff --git a/src/arqux/tools/migrate_v08.py b/src/arqux/tools/migrate_v08.py
new file mode 100644
index 0000000..e7b8af3
--- /dev/null
+++ b/src/arqux/tools/migrate_v08.py
@@ -0,0 +1,145 @@
+"""Migration 0.7.x → 0.8.x — idempotent and reversible.
+
+For each existing ArqUX 0.7.x project (a directory with
+``.arqux/brain.cortex``), this script:
+
+1. Detects the project (no-op if the project is already 0.8).
+2. Records the original 0.7.8 state in a backup file.
+3. Adds a ``.arqux/space.json`` describing the GovernedSpace
+   (type=project — ADR-002). Existing ``brain.cortex`` and
+   ``cycles/`` are untouched.
+4. Stamps a ``.arqux/version`` marker with the new version.
+5. Writes a migration log entry.
+
+The migration is intentionally minimal — the bulk of the data
+(the brain, the cycles, the blueprints) stays in 0.7 shape because
+the software domain pack (Phase 9) IS the compatibility layer. No
+destructive renames, no schema migrations. Only markers + metadata.
+
+Run:
+
+    python -m arqux.tools.migrate_v08 /path/to/project
+
+Or via the CLI once the CLI gains a ``migrate`` subcommand:
+
+    arqux migrate /path/to/project
+
+Idempotent: re-running is a no-op. Reversible: delete
+``.arqux/space.json`` and ``.arqux/version`` (or restore from the
+backup file).
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import sys
+import time
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+from typing import Any
+
+from arqux.kernel.space import GovernedSpace
+
+ARQUX_DIR = ".arqux"
+NEW_SPACE_FILE = "space.json"
+NEW_VERSION_FILE = "version"
+MIGRATION_LOG = "migration.log"
+BACKUP_SUFFIX = ".078.bak"
+
+
+@dataclass
+class MigrationReport:
+    """Result of a migration run — JSON-serializable for CI logs."""
+
+    project_root: str
+    migrated: bool = False
+    already_v08: bool = False
+    backup_path: str = ""
+    space_id: str = ""
+    space_type: str = "project"
+    log_path: str = ""
+    errors: list[str] = field(default_factory=list)
+
+
+def migrate_project(project_root: Path) -> MigrationReport:
+    """Migrate a 0.7.x project to 0.8 — idempotent + reversible."""
+    report = MigrationReport(project_root=str(project_root.resolve()))
+    if not project_root.is_dir():
+        report.errors.append(f"project root does not exist: {project_root}")
+        return report
+
+    arqux_dir = project_root / ARQUX_DIR
+    if not arqux_dir.exists():
+        report.errors.append(
+            f"no {ARQUX_DIR} directory — not an ArqUX project; skipping"
+        )
+        return report
+
+    version_file = arqux_dir / NEW_VERSION_FILE
+    if version_file.exists() and version_file.read_text(encoding="utf-8").strip().startswith("0.8"):
+        report.already_v08 = True
+        return report
+
+    # --- Backup before any change ---------------------------------------
+    brain_path = arqux_dir / "brain.cortex"
+    backup_path: Path | None = None
+    if brain_path.exists():
+        backup_path = brain_path.with_name(brain_path.name + BACKUP_SUFFIX)
+        if not backup_path.exists():
+            shutil.copy2(brain_path, backup_path)
+        report.backup_path = str(backup_path)
+
+    # --- Write the GovernedSpace descriptor -----------------------------
+    space = GovernedSpace.project(
+        id=project_root.name,
+        workspace_id="default",
+        title=project_root.name,
+        created_at=_now_iso(),
+    )
+    space_path = arqux_dir / NEW_SPACE_FILE
+    space_payload: dict[str, Any] = {
+        "id": space.id,
+        "type": space.type,
+        "workspace_id": space.workspace_id,
+        "title": space.title,
+        "created_at": space.created_at,
+        "kernel_api_version": "0.8.0",
+        "source_version": "0.7.8",
+    }
+    space_path.write_text(json.dumps(space_payload, indent=2, sort_keys=True), encoding="utf-8")
+
+    # --- Stamp the new version -----------------------------------------
+    version_file.write_text("0.8.0\n", encoding="utf-8")
+
+    # --- Append to migration log ---------------------------------------
+    log_path = arqux_dir / MIGRATION_LOG
+    with log_path.open("a", encoding="utf-8") as fh:
+        fh.write(
+            f"{_now_iso()} migrated=0.7.8→0.8.0 space_id={space.id} "
+            f"backup={report.backup_path or 'none'}\n"
+        )
+    report.log_path = str(log_path)
+    report.migrated = True
+    report.space_id = space.id
+    report.space_type = space.type
+    return report
+
+
+def _now_iso() -> str:
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = argv or sys.argv[1:]
+    if not args:
+        print("usage: python -m arqux.tools.migrate_v08 /path/to/project", file=sys.stderr)
+        return 2
+    project_root = Path(args[0]).expanduser().resolve()
+    report = migrate_project(project_root)
+    print(json.dumps(asdict(report), indent=2))
+    return 0 if not report.errors else 1
+
+
+if __name__ == "__main__":  # pragma: no cover
+    raise SystemExit(main())
