@@ -0,0 +1,50 @@
+"""Semantic CORTEX schema for the software domain (ADR-003).
+
+This declares which CORTEX section names are *semantic* for the
+software domain. The kernel never interprets ``FOCUS / KNOWLEDGE /
+LESSONS / RISKS / PULSE`` — it asks the active domain's schema
+instead.
+
+For 0.7.x compat, the schema reproduces the legacy sections exactly.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+# Legacy 0.7.x sections. Order is significant — the PULSE section is
+# append-only and lives at the end of brain.cortex.
+SECTIONS: tuple[tuple[str, str, str], ...] = (
+    # (id, title, mode)
+    ("$01", "IDENTITY", "fixed"),
+    ("$02", "CONTEXT", "fixed"),
+    ("$03", "FOCUS", "append-only"),
+    ("$04", "KNOWLEDGE", "append-only"),
+    ("$05", "RISKS", "append-only"),
+    ("$06", "LESSONS", "append-only"),
+    ("$07", "DECISIONS", "append-only"),
+    ("$08", "STATE", "mutable"),
+    ("$09", "AUDIT", "append-only"),
+    ("$10", "PROGRESS", "append-only"),
+    ("$11", "PULSE", "append-only"),  # legacy event log (BLP-042)
+)
+
+
+@dataclass(frozen=True)
+class SoftwareSchema:
+    """Declarative CORTEX schema for the software domain."""
+
+    name: str = "software"
+    sections: tuple[tuple[str, str, str], ...] = SECTIONS
+
+    def section_id(self, title: str) -> str | None:
+        for sid, stitle, _ in self.sections:
+            if stitle.upper() == title.upper():
+                return sid
+        return None
+
+    def mode_of(self, section_id: str) -> str | None:
+        for sid, _, mode in self.sections:
+            if sid == section_id:
+                return mode
+        return None
