+"""ArqUX 0.8 kernel — domain-agnostic core.
+
+This package contains the *only* code that does not know which domain
+it serves. The kernel defines the structural primitives (GovernedSpace,
+Activity, Task, ContractModel, Authority, Workflow, Evidence, Decision)
+and the SPI ports they rely on.
+
+Forbidden imports (enforced by ``tests/invariants/test_arch_dependencies.py``):
+
+- ``arqux.kernel`` MUST NOT import ``arqux.domains.*``
+- ``arqux.kernel`` MUST NOT import ``arqux.skills.*`` / ``arqux.handlers.*``
+- ``arqux.kernel`` MUST NOT hardcode semantic CORTEX section names
+  like ``FOCUS``, ``PULSE``, ``LESSONS`` (those belong to a domain
+  schema — see ADR-003).
+
+See ``docs/adr/ADR-001-separacion-kernel-dominio.md``.
+"""
+
+from __future__ import annotations
+
+__all__: list[str] = []
+
+# Version marker — bumped when the kernel API breaks.
+KERNEL_API_VERSION = "0.8.0"
diff --git a/src/arqux/kernel/activity.py b/src/arqux/kernel/activity.py
new file mode 100644
index 0000000..f434f8c
--- /dev/null
+++ b/src/arqux/kernel/activity.py
@@ -0,0 +1,60 @@
+"""Activity — first-class structural object with the WHY causal frame.
+
+In 0.7.x the WHY was implicit: a Blueprint carried an "objective" in
+§2 but the reason the Blueprint existed in the first place — what
+need triggered it, which Activity it belonged to — was lost.
+
+In 0.8 every Activity has:
+
+- ``purpose``         — what outcome the activity is trying to produce.
+- ``origin_need``     — the need that motivated the activity (a quote,
+                        a feature request, an incident, a regulation).
+- ``space_id``        — the GovernedSpace the activity lives in.
+- ``governance_release`` — which rules / packs were in force when the
+                        activity was created (Phase 8).
+
+The Activity is *not* a workflow stage. It is a stable container
+within which cycles, blueprints, tasks, decisions and evidence live.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Any
+
+_ACTIVITY_ID_RE = re.compile(r"^ACT-[A-Za-z0-9_\-]{1,63}$")
+
+
+@dataclass(frozen=True)
+class Activity:
+    """A first-class governed activity within a GovernedSpace."""
+
+    id: str
+    space_id: str
+    purpose: str
+    origin_need: str = ""
+    domain: str = "software"  # which domain pack owns the workflow
+    governance_release: str = ""  # GOV-YYYY.MM tag (Phase 8)
+    created_at: str = ""
+    created_by: str = ""  # Participant id
+    metadata: dict[str, Any] = field(default_factory=dict)
+    revision: int = 1
+
+    def __post_init__(self) -> None:
+        if not _ACTIVITY_ID_RE.match(self.id):
+            raise ValueError(
+                f"Activity.id must match {_ACTIVITY_ID_RE.pattern!r}; got {self.id!r}"
+            )
+        if not self.space_id:
+            raise ValueError("Activity.space_id is required")
+        if not self.purpose or len(self.purpose.strip()) < 3:
+            raise ValueError(
+                "Activity.purpose is required and must be at least 3 chars — "
+                "the WHY causal frame is mandatory in 0.8 (§2)."
+            )
+
+    def with_revision(self, **changes: Any) -> Activity:
+        from dataclasses import replace
+
+        return replace(self, revision=self.revision + 1, **changes)
diff --git a/src/arqux/kernel/contract.py b/src/arqux/kernel/contract.py
new file mode 100644
index 0000000..9f7797b
--- /dev/null
+++ b/src/arqux/kernel/contract.py
@@ -0,0 +1,478 @@
+"""Contract Engine — the Blueprint as a universal contract (Phase 2).
+
+A ``ContractModel`` is the universal building block in 0.8 — the same
+structure serves a software Blueprint (legacy 0.7), a procurement
+request, a compliance audit, or any other governed activity.
+
+12 dimensions (spec 0.8 §6):
+
+ 1. Identity        — contract_id, version, domain
+ 2. Purpose         — objective, success outcome
+ 3. Context         — space, activity, governance_release
+ 4. Scope           — ins, outs, assumptions
+ 5. Authority       — who can approve / delegate / sign
+ 6. Constraints     — budget, deadlines, regulations
+ 7. Risk            — identified risks + mitigations
+ 8. Tasks           — work to be performed
+ 9. Acceptance       — verifiable criteria
+10. Evidence         — what proves the contract was honoured
+11. Gates            — quality / approval gates (segregated authority)
+12. Closure          — what makes the contract "closed"
+
+Two faces:
+
+- ``ContractModel``         — the structured, machine-readable form.
+- ``ContractPresentation`` — how the contract is rendered (Markdown,
+  YAML, JSON, .cortex, slide, PDF, …). The parser existing in 0.7.x
+  stays — it discovers sections from declarative templates. The
+  kernel no longer hardcodes a single template.
+
+Contract Freeze + Amendment:
+
+- On approval, the *critical* dimensions (purpose, scope, constraints,
+  authority, acceptance, gates) are frozen: their canonical hash is
+  recorded and any later change forces a new revision with mandatory
+  causality (actor, authority, diff, reason).
+- The *non-critical* dimensions (evidence, progress, notes) stay
+  append-only — they evolve without forcing amendments.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+import time
+from dataclasses import asdict, dataclass, field
+from typing import Any
+
+# Contract id — kernel-wide shape, no domain-specific prefix.
+_CONTRACT_ID_RE = re.compile(r"^(CRT|BLP|PRC)-[A-Za-z0-9_\-]{1,63}$")
+
+# Critical dimensions: changes here require an Amendment after Freeze.
+CRITICAL_DIMENSIONS: frozenset[str] = frozenset(
+    {
+        "purpose",
+        "scope",
+        "constraints",
+        "authority",
+        "acceptance",
+        "gates",
+    }
+)
+
+# Non-critical dimensions: append-only after Freeze.
+APPEND_ONLY_DIMENSIONS: frozenset[str] = frozenset(
+    {
+        "evidence",
+        "progress",
+        "notes",
+    }
+)
+
+ALL_DIMENSIONS: tuple[str, ...] = (
+    "identity",
+    "purpose",
+    "context",
+    "scope",
+    "authority",
+    "constraints",
+    "risk",
+    "tasks",
+    "acceptance",
+    "evidence",
+    "gates",
+    "closure",
+)
+
+
+def _now_iso() -> str:
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+@dataclass(frozen=True)
+class ContractModel:
+    """A universal contract — 12 dimensions, revision-aware."""
+
+    contract_id: str
+    domain: str
+    activity_id: str
+    purpose: dict[str, Any]
+    scope: dict[str, Any]
+    authority: dict[str, Any]
+    constraints: dict[str, Any]
+    risk: dict[str, Any] = field(default_factory=dict)
+    tasks: list[dict[str, Any]] = field(default_factory=list)
+    acceptance: dict[str, Any] = field(default_factory=dict)
+    evidence: list[dict[str, Any]] = field(default_factory=list)
+    gates: list[dict[str, Any]] = field(default_factory=list)
+    closure: dict[str, Any] = field(default_factory=dict)
+    context: dict[str, Any] = field(default_factory=dict)
+    identity: dict[str, Any] = field(default_factory=dict)
+    revision: int = 1
+    frozen: bool = False
+    frozen_at: str = ""
+    frozen_hash: str = ""
+    profile: str = "G2"  # G0..G4 — Phase 3 resolver picks this
+
+    def __post_init__(self) -> None:
+        if not _CONTRACT_ID_RE.match(self.contract_id):
+            raise ValueError(
+                f"ContractModel.contract_id must match {_CONTRACT_ID_RE.pattern!r}; "
+                f"got {self.contract_id!r}"
+            )
+        if not self.activity_id:
+            raise ValueError("ContractModel.activity_id is required")
+
+    # ------------------------------------------------------------------
+    # Freeze + Amendment.
+    # ------------------------------------------------------------------
+    def freeze(self, *, actor: str, authority: str) -> ContractModel:
+        """Freeze the critical dimensions of the contract.
+
+        Computes the canonical hash of the critical dimensions and
+        marks the contract as frozen. Subsequent mutations of any
+        critical dimension MUST go through ``amend`` (which produces
+        a new revision).
+        """
+        if self.frozen:
+            raise ValueError("contract already frozen — use amend() for changes")
+        h = self._critical_hash()
+        frozen_identity = dict(self.identity)
+        frozen_identity.setdefault("frozen_by", actor)
+        frozen_identity["frozen_with_authority"] = authority
+        frozen_identity["frozen_at"] = _now_iso()
+        # ``frozen_identity`` is part of identity (non-critical), so we
+        # don't need an Amendment to update it.
+        return ContractModel(
+            contract_id=self.contract_id,
+            domain=self.domain,
+            activity_id=self.activity_id,
+            purpose=self.purpose,
+            scope=self.scope,
+            authority=self.authority,
+            constraints=self.constraints,
+            risk=self.risk,
+            tasks=list(self.tasks),
+            acceptance=self.acceptance,
+            evidence=list(self.evidence),
+            gates=list(self.gates),
+            closure=self.closure,
+            context=self.context,
+            identity=frozen_identity,
+            revision=self.revision,
+            frozen=True,
+            frozen_at=_now_iso(),
+            frozen_hash=h,
+            profile=self.profile,
+        )
+
+    def amend(
+        self,
+        *,
+        actor: str,
+        authority: str,
+        reason: str,
+        critical_changes: dict[str, Any] | None = None,
+        append_only_changes: dict[str, Any] | None = None,
+    ) -> ContractModel:
+        """Produce a new revision with mandatory causality.
+
+        ``critical_changes`` may include any subset of
+        ``CRITICAL_DIMENSIONS``. ``append_only_changes`` may include
+        any subset of ``APPEND_ONLY_DIMENSIONS`` (extended, never
+        overwritten).
+
+        Both require ``reason`` (≥ 10 chars) and ``authority``
+        (the lease or role under which the amendment is made).
+
+        Spec: append-only dimensions evolve *without* forcing an
+        amendment. Use ``extend_append_only()`` for pure appends.
+        ``amend()`` requires at least one critical change — a
+        pure-append call is routed to extend_append_only instead of
+        being silently rejected (this preserves the spec invariant
+        that an amendment MUST reflect a critical-dimension change).
+        """
+        if not self.frozen:
+            raise ValueError("cannot amend a contract that is not frozen — use freeze() first")
+        if len(reason.strip()) < 10:
+            raise ValueError("amend reason must be at least 10 chars — causality is mandatory")
+        if not authority:
+            raise ValueError("amend authority is required — name a lease id or role")
+
+        bad = (critical_changes or {}).keys() - CRITICAL_DIMENSIONS
+        if bad:
+            raise ValueError(
+                f"unexpected critical dimensions {sorted(bad)}; "
+                f"expected subset of {sorted(CRITICAL_DIMENSIONS)}"
+            )
+        bad_append = (append_only_changes or {}).keys() - APPEND_ONLY_DIMENSIONS
+        if bad_append:
+            raise ValueError(
+                f"unexpected append-only dimensions {sorted(bad_append)}; "
+                f"expected subset of {sorted(APPEND_ONLY_DIMENSIONS)}"
+            )
+
+        # Spec: an amendment MUST change at least one critical dimension.
+        # If only append-only changes were provided, route to
+        # extend_append_only() instead of producing a no-op amend.
+        if not critical_changes:
+            if append_only_changes:
+                return self.extend_append_only(
+                    actor=actor,
+                    authority=authority,
+                    reason=reason,
+                    **dict(append_only_changes),
+                )
+            raise ValueError(
+                "amend requires at least one critical change — pure-append "
+                "changes belong to extend_append_only()"
+            )
+
+        # Apply critical changes (replace).
+        merged_critical: dict[str, Any] = {
+            "purpose": dict(self.purpose),
+            "scope": dict(self.scope),
+            "authority": dict(self.authority),
+            "constraints": dict(self.constraints),
+            "acceptance": dict(self.acceptance),
+            "gates": list(self.gates),
+        }
+        for k, v in (critical_changes or {}).items():
+            merged_critical[k] = v
+
+        # Apply append-only changes (extend — never replace).
+        merged_append_evidence = list(self.evidence)
+        merged_append_progress = list(self.identity.get("progress", []))
+        merged_append_notes = list(self.identity.get("notes", []))
+        if append_only_changes:
+            if "evidence" in append_only_changes:
+                merged_append_evidence.extend(append_only_changes["evidence"])
+            if "progress" in append_only_changes:
+                merged_append_progress.extend(append_only_changes["progress"])
+            if "notes" in append_only_changes:
+                merged_append_notes.extend(append_only_changes["notes"])
+
+        new_identity = dict(self.identity)
+        new_identity["progress"] = merged_append_progress
+        new_identity["notes"] = merged_append_notes
+        new_identity["last_amendment"] = {
+            "actor": actor,
+            "authority": authority,
+            "reason": reason,
+            "from_revision": self.revision,
+            "at": _now_iso(),
+            "diff": {
+                k: {"from": getattr(self, k), "to": merged_critical[k]}
+                for k in (critical_changes or {})
+            },
+        }
+
+        # Recompute frozen hash with new critical dims — it must
+        # differ from the previous one (otherwise the amendment is
+        # a no-op and should be rejected).
+        new_critical = {
+            "purpose": merged_critical["purpose"],
+            "scope": merged_critical["scope"],
+            "authority": merged_critical["authority"],
+            "constraints": merged_critical["constraints"],
+            "acceptance": merged_critical["acceptance"],
+            "gates": merged_critical["gates"],
+        }
+        new_hash = _canonical_hash(new_critical)
+        if new_hash == self.frozen_hash:
+            raise ValueError(
+                "amendment produced the same critical hash as the previous "
+                "revision — no critical change was actually made; reject as no-op"
+            )
+
+        return ContractModel(
+            contract_id=self.contract_id,
+            domain=self.domain,
+            activity_id=self.activity_id,
+            purpose=new_critical["purpose"],
+            scope=new_critical["scope"],
+            authority=new_critical["authority"],
+            constraints=new_critical["constraints"],
+            risk=self.risk,
+            tasks=list(self.tasks),
+            acceptance=new_critical["acceptance"],
+            evidence=merged_append_evidence,
+            gates=new_critical["gates"],
+            closure=self.closure,
+            context=self.context,
+            identity=new_identity,
+            revision=self.revision + 1,
+            frozen=True,
+            frozen_at=self.frozen_at,
+            frozen_hash=new_hash,
+            profile=self.profile,
+        )
+
+    def extend_append_only(
+        self,
+        *,
+        actor: str,
+        authority: str,
+        reason: str,
+        evidence: list[dict[str, Any]] | None = None,
+        notes: list[str] | None = None,
+        progress: list[dict[str, Any]] | None = None,
+    ) -> ContractModel:
+        """Extend append-only dimensions WITHOUT forcing an amendment.
+
+        Spec: evidence, progress, and notes are append-only — they
+        evolve without bumping the contract revision or recomputing
+        the frozen hash. The causality (actor, authority, reason) is
+        still recorded in ``identity.last_append`` for audit.
+
+        Returns a new ``ContractModel`` with the same ``revision``,
+        ``frozen_hash``, and frozen state — only the append-only
+        fields grow.
+        """
+        if not self.frozen:
+            raise ValueError(
+                "extend_append_only requires a frozen contract — use freeze() first"
+            )
+        if len(reason.strip()) < 10:
+            raise ValueError(
+                "extend_append_only reason must be at least 10 chars — "
+                "causality is mandatory even for appends"
+            )
+        if not authority:
+            raise ValueError("extend_append_only authority is required")
+
+        new_evidence = list(self.evidence) + list(evidence or [])
+        new_identity = dict(self.identity)
+        new_progress = list(new_identity.get("progress", [])) + list(progress or [])
+        new_notes = list(new_identity.get("notes", [])) + list(notes or [])
+        new_identity["progress"] = new_progress
+        new_identity["notes"] = new_notes
+        new_identity["last_append"] = {
+            "actor": actor,
+            "authority": authority,
+            "reason": reason,
+            "at": _now_iso(),
+            "evidence_added": len(evidence or []),
+            "notes_added": len(notes or []),
+            "progress_added": len(progress or []),
+        }
+
+        # Return a new revision-SAME instance — only append-only fields
+        # grew, so the frozen hash and revision are preserved.
+        return ContractModel(
+            contract_id=self.contract_id,
+            domain=self.domain,
+            activity_id=self.activity_id,
+            purpose=self.purpose,
+            scope=self.scope,
+            authority=self.authority,
+            constraints=self.constraints,
+            risk=self.risk,
+            tasks=list(self.tasks),
+            acceptance=self.acceptance,
+            evidence=new_evidence,
+            gates=list(self.gates),
+            closure=self.closure,
+            context=self.context,
+            identity=new_identity,
+            revision=self.revision,  # unchanged — append-only
+            frozen=True,
+            frozen_at=self.frozen_at,
+            frozen_hash=self.frozen_hash,  # unchanged — critical dims same
+            profile=self.profile,
+        )
+
+    # ------------------------------------------------------------------
+    # Internals.
+    # ------------------------------------------------------------------
+    def _critical_hash(self) -> str:
+        payload = {
+            "purpose": self.purpose,
+            "scope": self.scope,
+            "authority": self.authority,
+            "constraints": self.constraints,
+            "acceptance": self.acceptance,
+            "gates": self.gates,
+        }
+        return _canonical_hash(payload)
+
+    def verify_frozen(self) -> bool:
+        """Return True iff the current critical dimensions hash to ``frozen_hash``."""
+        if not self.frozen:
+            return False
+        return self._critical_hash() == self.frozen_hash
+
+
+def _canonical_hash(payload: dict[str, Any]) -> str:
+    """Canonical hash of a payload.
+
+    Uses JSON with sorted keys + separators. Domains that need a
+    fancier canonicalisation (e.g. JCS) can register their own
+    hasher via the SPI (Phase 6).
+    """
+    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"), default=asdict)
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+# ---------------------------------------------------------------------------
+# CompactContract — G1 profile.
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class CompactContract:
+    """Minimal contract for G1 profile (Phase 3).
+
+    A G1 contract is a "compact" version: purpose + acceptance +
+    minimal authority. No full 12-dimension structure. Suitable for
+    low-risk, low-impact activities that still need a record.
+    """
+
+    contract_id: str
+    activity_id: str
+    purpose: str
+    acceptance: str
+    authority: str
+    profile: str = "G1"
+
+    def __post_init__(self) -> None:
+        if not _CONTRACT_ID_RE.match(self.contract_id):
+            raise ValueError(
+                f"CompactContract.contract_id must match {_CONTRACT_ID_RE.pattern!r}"
+            )
+        if len(self.purpose) < 10:
+            raise ValueError("CompactContract.purpose must be at least 10 chars")
+        if len(self.acceptance) < 5:
+            raise ValueError("CompactContract.acceptance must be at least 5 chars")
+        if not self.authority:
+            raise ValueError("CompactContract.authority is required")
+
+
+# ---------------------------------------------------------------------------
+# ContractPresentation — kernel stays presentation-agnostic.
+# ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class ContractPresentation:
+    """How a ContractModel is rendered — Markdown, YAML, .cortex, …
+
+    The parser existing in 0.7.x stays in ``arqux.formats`` and
+    ``arqux.cortex``. The kernel exposes this port so that a domain
+    can declare its own presentation (e.g. a procurement pack might
+    want a "quote sheet" presentation alongside the canonical Markdown).
+    """
+
+    contract_id: str
+    revision: int
+    media_type: str  # e.g. "text/markdown", "application/yaml"
+    body: str
+    template_ref: str = ""  # which template produced this presentation
+    digest: str = ""  # SHA-256 of body — for cheap equality checks
+
+    def __post_init__(self) -> None:
+        if not self.body:
+            raise ValueError("ContractPresentation.body is required")
+        if not self.digest:
+            object.__setattr__(self, "digest", hashlib.sha256(self.body.encode("utf-8")).hexdigest())
diff --git a/src/arqux/kernel/space.py b/src/arqux/kernel/space.py
new file mode 100644
index 0000000..3f6370a
--- /dev/null
+++ b/src/arqux/kernel/space.py
@@ -0,0 +1,142 @@
+"""GovernedSpace — the structural root of every governed context.
+
+A GovernedSpace is the entity within which governance happens. It
+generalises ArqUX 0.7's ``Project`` to any kind of governed object:
+projects, processes, departments, services, assets, cases, programs,
+business units — and arbitrary custom types registered by domain
+packs.
+
+See:
+- ADR-002: ``Project`` is a factory alias of ``GovernedSpace(type='project')``.
+- Plan v0.8 Phase 1.
+
+Invariants enforced here:
+- ``id`` is unique within a Workspace.
+- ``type`` is one of the supported set (or registered by a domain pack).
+- A space owns at least one ``Activity`` once it is past the empty
+  bootstrap state.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Any, Literal
+
+# Canonical built-in types. Domain packs may register more via
+# ``register_space_type`` (see ``arqux.spi``).
+SpaceType = Literal[
+    "project",
+    "process",
+    "department",
+    "service",
+    "asset",
+    "case",
+    "program",
+    "business-unit",
+    "custom",
+]
+
+# Stable pattern for space IDs. Domain-agnostic — no BLP/CYC conventions.
+_SPACE_ID_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_\-]{0,63}$")
+
+
+_REGISTERED_TYPES: set[str] = set()
+
+
+def register_space_type(name: str) -> None:
+    """Register a custom ``SpaceType`` from a domain pack.
+
+    The kernel never calls this — only the SPI loader does. Tests
+    assert the loader is the only caller.
+    """
+    if not name or not _SPACE_ID_RE.match(name):
+        raise ValueError(f"invalid space type: {name!r}")
+    _REGISTERED_TYPES.add(name)
+
+
+def known_space_types() -> frozenset[str]:
+    return frozenset(_REGISTERED_TYPES)
+
+
+@dataclass(frozen=True)
+class GovernedSpace:
+    """An immutable snapshot of a governed space.
+
+    Mutation goes through ``with_revision`` — never in place. This
+    matches the append-only nature of the underlying CORTEX store
+    (ADR-003).
+    """
+
+    id: str
+    type: str  # SpaceType (string to allow domain-pack extension)
+    workspace_id: str = "default"
+    parent_space_id: str | None = None
+    title: str = ""
+    metadata: dict[str, Any] = field(default_factory=dict)
+    created_at: str = ""
+    revision: int = 1
+
+    def __post_init__(self) -> None:
+        if not _SPACE_ID_RE.match(self.id):
+            raise ValueError(
+                f"GovernedSpace.id must match {_SPACE_ID_RE.pattern!r}; got {self.id!r}"
+            )
+        if self.type not in _REGISTERED_TYPES:
+            # Lazy-build the built-in set on first use because Literal
+            # introspection is awkward across Python versions.
+            builtins = {
+                "project",
+                "process",
+                "department",
+                "service",
+                "asset",
+                "case",
+                "program",
+                "business-unit",
+                "custom",
+            }
+            if self.type not in builtins and self.type not in _REGISTERED_TYPES:
+                raise ValueError(
+                    f"unknown space type {self.type!r}; "
+                    f"register it via arqux.spi.register_space_type() "
+                    f"or use one of {sorted(builtins)}"
+                )
+
+    # ------------------------------------------------------------------
+    # Compat with 0.7.x — Project as a factory alias.
+    # ------------------------------------------------------------------
+    @classmethod
+    def project(
+        cls,
+        *,
+        id: str,
+        workspace_id: str = "default",
+        title: str = "",
+        metadata: dict[str, Any] | None = None,
+        created_at: str = "",
+    ) -> GovernedSpace:
+        """``Project`` factory alias — preserves the 0.7.x naming.
+
+        ``arqux_domain_software`` calls this from its handlers so
+        existing CLI users see no breakage.
+        """
+        return cls(
+            id=id,
+            type="project",
+            workspace_id=workspace_id,
+            title=title,
+            metadata=metadata or {},
+            created_at=created_at,
+        )
+
+    def with_revision(self, **changes: Any) -> GovernedSpace:
+        """Return a new revision of the space (immutable update)."""
+        from dataclasses import replace
+
+        return replace(self, revision=self.revision + 1, **changes)
+
+
+def Project(*, id: str, **kwargs: Any) -> GovernedSpace:  # noqa: N802 — 0.7.x API
+    """Module-level factory alias (matches 0.7 call shape)."""
+    return GovernedSpace.project(id=id, **kwargs)
diff --git a/src/arqux/kernel/task.py b/src/arqux/kernel/task.py
new file mode 100644
index 0000000..c03b513
--- /dev/null
+++ b/src/arqux/kernel/task.py
@@ -0,0 +1,105 @@
+"""Task — distinguishing logical existence from physical materialization.
+
+In 0.7.x a Task is embedded inside a Blueprint (§14). Once the
+Blueprint transitions to ``done``, the tasks are gone from the
+system: they have no own identity, no own evidence, no own delegations.
+
+In 0.8 a Task is an entity that can be:
+
+- **logically embedded** in a Blueprint — same as 0.7.x, the task is
+  a row inside the contract body, no independent lifecycle.
+- **physically materialized** — promoted to an independent artefact
+  with its own id, its own Contract (sub-contract), its own evidence,
+  its own delegations. The Blueprint holds a reference instead of a
+  row.
+
+The kernel exposes both shapes. Domain packs decide when to
+materialize (typically: when a task needs independent authority
+delegation, or independent evidence production, or independent
+recovery on failure).
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Any
+
+# Logical task id: prefix T- inside a Blueprint (legacy 0.7).
+# Physical task id: prefix TASK- globally unique.
+_TASK_LOGICAL_RE = re.compile(r"^T-\d{1,6}(\.\d{1,3})?$")
+_TASK_PHYSICAL_RE = re.compile(r"^TASK-[A-Za-z0-9_\-]{1,63}$")
+
+
+@dataclass(frozen=True)
+class Task:
+    """A unit of work inside an Activity.
+
+    A Task has two materialisations:
+
+    - ``kind='logical'``    — embedded in a Contract/Blueprint body. No
+                              own lifecycle, no own authority lease.
+                              ``logical_ref`` carries the in-contract id
+                              (e.g. ``T-12``).
+    - ``kind='materialized'`` — promoted to an independent artefact.
+                              Owns its own Contract (sub-contract),
+                              its own evidence, its own delegations.
+
+    The two shapes are mutually exclusive — a task cannot be both at
+    the same time. Promoting logical → materialized is a one-way
+    operation recorded as an Amendment (Phase 2).
+    """
+
+    id: str
+    activity_id: str
+    kind: str = "logical"
+    title: str = ""
+    logical_ref: str = ""  # e.g. "T-12" — only when kind == 'logical'
+    contract_id: str | None = None  # sub-contract — only when kind == 'materialized'
+    delegated_to: str | None = None  # Participant id — only when materialized
+    metadata: dict[str, Any] = field(default_factory=dict)
+    revision: int = 1
+
+    def __post_init__(self) -> None:
+        if self.kind not in ("logical", "materialized"):
+            raise ValueError(
+                f"Task.kind must be 'logical' or 'materialized'; got {self.kind!r}"
+            )
+        if self.kind == "logical":
+            if not self.logical_ref or not _TASK_LOGICAL_RE.match(self.logical_ref):
+                raise ValueError(
+                    f"logical Task.logical_ref must match {_TASK_LOGICAL_RE.pattern!r}; "
+                    f"got {self.logical_ref!r}"
+                )
+            if self.contract_id or self.delegated_to:
+                raise ValueError(
+                    "logical Task cannot carry contract_id or delegated_to — "
+                    "promote it to 'materialized' first"
+                )
+        else:  # materialized
+            if not _TASK_PHYSICAL_RE.match(self.id):
+                raise ValueError(
+                    f"materialized Task.id must match {_TASK_PHYSICAL_RE.pattern!r}; "
+                    f"got {self.id!r}"
+                )
+
+    def promote(self, *, new_id: str, sub_contract_id: str) -> Task:
+        """Promote a logical task to a materialized one.
+
+        This is the kernel primitive — domain packs decide WHEN to
+        call it. The call MUST be wrapped in an Amendment (Phase 2)
+        because it changes the structure of the parent Contract.
+        """
+        if self.kind != "logical":
+            raise ValueError("only logical Tasks can be promoted")
+        # Note: we keep ``logical_ref`` so audits can trace origin.
+        return Task(
+            id=new_id,
+            activity_id=self.activity_id,
+            kind="materialized",
+            title=self.title,
+            logical_ref=self.logical_ref,
+            contract_id=sub_contract_id,
+            metadata=dict(self.metadata),
+            revision=self.revision + 1,
+        )
diff --git a/src/arqux/spi/__init__.py b/src/arqux/spi/__init__.py
new file mode 100644
index 0000000..136b2ca
--- /dev/null
+++ b/src/arqux/spi/__init__.py
@@ -0,0 +1,176 @@
+"""SPI — extension ports that domain packs implement.
+
+The kernel never imports ``arqux.domains.*``. Instead, domain packs
+register their implementations of these ports via the provider
+registry. The kernel consumes them through the public API of this
+module.
+
+9 providers (Phase 9):
+
+1. DomainProvider       — space types, identity, schemas
+2. WorkflowProvider     — workflow definitions (declarative)
+3. CapabilityProvider   — capability catalogue (skill + effect class)
+4. EvidenceProvider     — evidence kinds + storage backends
+5. PolicyProvider       — org-level overrides to the resolver
+6. RiskProvider         — risk classifiers (regulatory, financial, …)
+7. AssuranceProvider    — lenses for assurance runtime
+8. AdapterProvider      — fs / mcp / http / external integrations
+9. ProjectionProvider   — CORTEX legacy projection (PULSE, etc.)
+
+Each provider is identified by a stable ``id``. A provider carries
+its own ``api_version`` — the loader rejects mismatches at register
+time. The ``Manifest`` is the verifiable contract a pack exposes.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass, field
+from typing import Protocol, runtime_checkable
+
+# Manifest id — pack-name + version. Allows dotted versions.
+_MANIFEST_ID_RE = re.compile(r"^[a-z][a-z0-9\-]{1,63}(@[0-9]+\.[0-9]+\.[0-9]+[a-z0-9.\-]*)?$")
+
+# Current SPI api_version. Bumped when a provider signature breaks.
+SPI_API_VERSION = "0.8.0"
+
+# Effect classes — capability providers must declare one of these.
+EFFECT_CLASSES: frozenset[str] = frozenset(
+    {
+        "none",
+        "local",
+        "internal",
+        "external",
+        "financial",
+        "legal",
+        "physical",
+        "public",
+        "irreversible",
+    }
+)
+
+
+@dataclass(frozen=True)
+class Manifest:
+    """Extension manifest — declared by a domain pack.
+
+    Every pack exposes a ``Manifest`` at its package root. The SPI
+    loader reads it before allowing the pack to register providers.
+    """
+
+    id: str
+    api_version: str
+    version: str
+    domain: str  # which domain this pack serves
+    dependencies: list[str] = field(default_factory=list)
+    capabilities: list[str] = field(default_factory=list)
+    effects: list[str] = field(default_factory=list)
+    authority_requirements: list[str] = field(default_factory=list)
+    risk: str = "low"  # default
+    idempotency: str = "recommended"
+    evidence_contract: str = ""
+
+    def __post_init__(self) -> None:
+        if not _MANIFEST_ID_RE.match(self.id):
+            raise ValueError(
+                f"Manifest.id must match {_MANIFEST_ID_RE.pattern!r}; got {self.id!r}"
+            )
+        if self.api_version != SPI_API_VERSION:
+            raise ValueError(
+                f"Manifest {self.id!r} targets api_version {self.api_version!r}; "
+                f"kernel SPI is {SPI_API_VERSION!r}. Loader rejects mismatch — "
+                f"see arqux.spi.conformity_suite()"
+            )
+        bad = [e for e in self.effects if e not in EFFECT_CLASSES]
+        if bad:
+            raise ValueError(
+                f"Manifest {self.id!r} declares unknown effects {bad}; "
+                f"expected subset of {sorted(EFFECT_CLASSES)}"
+            )
+        if self.risk not in {"low", "medium", "high", "critical"}:
+            raise ValueError(
+                f"Manifest {self.id!r} has invalid risk {self.risk!r}; "
+                f"expected one of low/medium/high/critical"
+            )
+        if self.idempotency not in {"required", "recommended", "optional"}:
+            raise ValueError(
+                f"Manifest {self.id!r} has invalid idempotency {self.idempotency!r}"
+            )
+
+
+@runtime_checkable
+class Provider(Protocol):
+    """Marker protocol — every concrete provider implements this."""
+
+    manifest_id: str
+    name: str  # short human label
+
+
+# ---------------------------------------------------------------------------
+# Registry — singleton, populated at pack load time.
+# ---------------------------------------------------------------------------
+
+_PROVIDERS: dict[str, dict[str, Provider]] = {
+    # provider_kind -> {manifest_id -> provider_instance}
+    "domain": {},
+    "workflow": {},
+    "capability": {},
+    "evidence": {},
+    "policy": {},
+    "risk": {},
+    "assurance": {},
+    "adapter": {},
+    "projection": {},
+}
+
+
+def register_provider(kind: str, manifest_id: str, instance: Provider) -> None:
+    if kind not in _PROVIDERS:
+        raise ValueError(f"unknown provider kind {kind!r}")
+    if kind in {"domain", "workflow", "capability", "evidence", "policy",
+                "risk", "assurance", "adapter", "projection"}:
+        bucket = _PROVIDERS[kind]
+        if manifest_id in bucket and bucket[manifest_id] is not instance:
+            raise ValueError(
+                f"a {kind!r} provider is already registered for {manifest_id!r}"
+            )
+        bucket[manifest_id] = instance
+
+
+def get_providers(kind: str) -> dict[str, Provider]:
+    if kind not in _PROVIDERS:
+        raise ValueError(f"unknown provider kind {kind!r}")
+    return dict(_PROVIDERS[kind])
+
+
+def reset_registry() -> None:
+    """Test helper — wipe all registered providers."""
+    for bucket in _PROVIDERS.values():
+        bucket.clear()
+
+
+def conformity_suite(manifest: Manifest) -> list[str]:
+    """Static checks every pack MUST pass before registration.
+
+    Returns the list of failures (empty list means pass). The loader
+    refuses to register a pack whose conformity_suite returns any
+    failures.
+    """
+    failures: list[str] = []
+    if manifest.api_version != SPI_API_VERSION:
+        failures.append(
+            f"api_version mismatch: {manifest.api_version} != {SPI_API_VERSION}"
+        )
+    if not manifest.domain:
+        failures.append("manifest.domain is required")
+    if not _MANIFEST_ID_RE.match(manifest.id):
+        failures.append(f"manifest.id {manifest.id!r} fails naming convention")
+    if manifest.effects and not all(e in EFFECT_CLASSES for e in manifest.effects):
+        failures.append(
+            f"manifest.effects must be subset of {sorted(EFFECT_CLASSES)}"
+        )
+    if manifest.risk not in {"low", "medium", "high", "critical"}:
+        failures.append(f"manifest.risk invalid: {manifest.risk!r}")
+    if manifest.idempotency not in {"required", "recommended", "optional"}:
+        failures.append(f"manifest.idempotency invalid: {manifest.idempotency!r}")
+    return failures
