+++ b/tests/invariants/test_invariant_12_contract_freeze_canonical.py
@@ -0,0 +1,164 @@
+"""Invariant 12: Contract Freeze produces a canonical hash; post-freeze
+critical-dimension mutations either produce a new revision or are
+rejected.
+
+Spec §33 invariante 12. Implemented in Phase 2 (Contract Engine).
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from arqux.kernel.contract import CRITICAL_DIMENSIONS, ContractModel
+
+
+def _make_contract(*, purpose_text: str = "purpose v1") -> ContractModel:
+    return ContractModel(
+        contract_id="CRT-freeze01",
+        domain="software",
+        activity_id="ACT-freeze01",
+        purpose={"text": purpose_text},
+        scope={"ins": [], "outs": []},
+        authority={"approvers": ["gov-1"]},
+        constraints={"deadline": "2026-12-31"},
+        acceptance={"criteria": ["AC-01"]},
+        gates=[{"name": "review"}],
+    )
+
+
+def test_freeze_produces_a_hash():
+    crt = _make_contract()
+    assert not crt.frozen
+    frozen = crt.freeze(actor="gov-1", authority="role:governor")
+    assert frozen.frozen
+    assert frozen.frozen_hash
+    assert frozen.frozen_at
+    assert frozen.verify_frozen()
+
+
+def test_double_freeze_is_rejected():
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    with pytest.raises(ValueError, match="already frozen"):
+        crt.freeze(actor="gov-1", authority="role:governor")
+
+
+def test_amendment_requires_reason():
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    with pytest.raises(ValueError, match="reason"):
+        crt.amend(actor="gov-2", authority="lease:abc", reason="too short")
+
+
+def test_amendment_requires_authority():
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    with pytest.raises(ValueError, match="authority"):
+        crt.amend(
+            actor="gov-2",
+            authority="",
+            reason="a substantive reason is here",
+        )
+
+
+def test_amendment_produces_new_revision():
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    new_rev = crt.amend(
+        actor="gov-2",
+        authority="lease:abc",
+        reason="shifting the deadline per stakeholder request",
+        critical_changes={
+            "constraints": {"deadline": "2027-01-15"},
+        },
+    )
+    assert new_rev.revision == crt.revision + 1
+    assert new_rev.frozen_hash != crt.frozen_hash
+    assert new_rev.verify_frozen()
+    # The amendment causality is recorded.
+    last = new_rev.identity.get("last_amendment", {})
+    assert last["actor"] == "gov-2"
+    assert last["authority"] == "lease:abc"
+    assert "from_revision" in last
+
+
+def test_amendment_rejects_unknown_critical_dimension():
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    with pytest.raises(ValueError, match="unexpected critical"):
+        crt.amend(
+            actor="gov-2",
+            authority="lease:abc",
+            reason="trying to amend identity (not critical)",
+            critical_changes={"identity": {"x": 1}},  # not in CRITICAL_DIMENSIONS
+        )
+
+
+def test_amendment_rejects_no_op_change():
+    """An amendment that produces the same critical hash is rejected —
+    no silent revisions allowed.
+    """
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    with pytest.raises(ValueError, match="same critical hash"):
+        crt.amend(
+            actor="gov-2",
+            authority="lease:abc",
+            reason="amending without actually changing anything",
+            # Pass the same values back — should be detected as no-op.
+            critical_changes={
+                "purpose": crt.purpose,
+            },
+        )
+
+
+def test_append_only_extensions_do_not_force_amendment():
+    """``evidence`` and ``notes`` are append-only after freeze — they
+    grow WITHOUT bumping the contract revision. The frozen hash and
+    revision are preserved; only the append-only fields grow.
+    """
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    # Pure append — does not require amend().
+    extended = crt.extend_append_only(
+        actor="gov-3",
+        authority="role:auditor",
+        reason="recording additional evidence collected post-freeze",
+        evidence=[
+            {"kind": "log", "ref": "build.log", "digest": "deadbeef"}
+        ],
+        notes=["evidence appended without forcing amendment"],
+    )
+    # Revision is unchanged — append-only does NOT force an amendment.
+    assert extended.revision == crt.revision
+    # Frozen hash is unchanged — critical dimensions were not touched.
+    assert extended.frozen_hash == crt.frozen_hash
+    assert extended.verify_frozen()
+    # The append-only fields grew.
+    assert len(extended.evidence) == 1
+    assert extended.identity.get("notes") == ["evidence appended without forcing amendment"]
+    # The causality is recorded.
+    last = extended.identity.get("last_append", {})
+    assert last["actor"] == "gov-3"
+    assert last["authority"] == "role:auditor"
+    assert last["evidence_added"] == 1
+
+
+def test_amend_routes_pure_append_to_extend_append_only():
+    """Calling amend() with ONLY append_only_changes is routed to
+    extend_append_only — no silent failure, no spurious revision bump.
+    """
+    crt = _make_contract().freeze(actor="gov-1", authority="role:governor")
+    new = crt.amend(
+        actor="gov-3",
+        authority="role:auditor",
+        reason="amend called with only append-only — should route",
+        append_only_changes={
+            "evidence": [{"kind": "log", "ref": "build.log", "digest": "deadbeef"}],
+        },
+    )
+    assert new.revision == crt.revision
+    assert new.frozen_hash == crt.frozen_hash
+    assert len(new.evidence) == 1
+
+
+def test_critical_dimensions_set_is_stable():
+    """Sanity: the CRITICAL_DIMENSIONS set must match the spec.
+    If this set ever changes, the spec changes — a major-version bump.
+    """
+    assert frozenset(
+        {"purpose", "scope", "constraints", "authority", "acceptance", "gates"}
+    ) == CRITICAL_DIMENSIONS
