@@ -0,0 +1,61 @@
+"""Invariant 02: Capability does not imply Authority.
+
+A participant having a Skill (capability) does NOT mean they have
+Authority to invoke it. The Authority Gate is the only path between
+capability and authority — every execution route goes through it.
+
+Spec §33 invariante 02. Implemented in Phase 4 (Authority Engine).
+
+This test asserts the architectural rule: the kernel exposes
+``evaluate_authority()`` and no other public path produces an
+"allowed" decision. We verify the rule structurally by inspecting
+the kernel module surface.
+"""
+
+from __future__ import annotations
+
+import inspect
+
+from arqux.kernel import contract as _contract
+
+
+def test_capability_is_separate_field_in_authority_section():
+    """A ContractModel's ``authority`` section cannot grant authority
+    via capability alone — it lists roles/leases, never capabilities.
+    """
+    crt = _contract.ContractModel(
+        contract_id="CRT-test01",
+        domain="software",
+        activity_id="ACT-test01",
+        purpose={"text": "test"},
+        scope={"ins": [], "outs": []},
+        authority={
+            "approvers": ["gov-1"],
+            "delegations": [],
+            # NOTE: no "capabilities" key — capability is NOT authority.
+        },
+        constraints={},
+    )
+    # The 'authority' dict has no "capabilities" path — the field is
+    # explicitly forbidden by the model.
+    assert "capabilities" not in crt.authority
+
+
+def test_no_public_shortcut_to_allowed_authority():
+    """The kernel module surface has no ``authorize()`` or ``grant()``
+    shortcut — the only path to an authority decision goes through
+    the (yet-to-be-built) Authority Gate.
+    """
+    # For Phase 0..2, this test simply verifies that the kernel does
+    # not expose any 'authorize' / 'grant' / 'allow' symbols yet.
+    # When Phase 4 lands, this test will be replaced by the actual
+    # gate being the only allowed path.
+    public = [
+        name
+        for name, _ in inspect.getmembers(_contract, predicate=inspect.isfunction)
+        if not name.startswith("_")
+    ]
+    forbidden = {"authorize", "grant", "allow", "is_authorized"}
+    assert not (set(public) & forbidden), (
+        f"kernel.contract must not expose authority shortcuts: {public}"
+    )
diff --git a/tests/invariants/test_invariant_10_new_domain_no_kernel_touch.py b/tests/invariants/test_invariant_10_new_domain_no_kernel_touch.py
new file mode 100644
index 0000000..4f17752
--- /dev/null
+++ b/tests/invariants/test_invariant_10_new_domain_no_kernel_touch.py
@@ -0,0 +1,91 @@
+"""Invariant 10: A new domain can be added without touching the kernel.
+
+Spec §33 invariante 10. Implemented in Phase 9 (Extension SPI + Domain
+Packs).
+
+This test loads the procurement pilot pack and verifies:
+
+1. Its manifest conforms (conformity_suite passes).
+2. Its domain ("procurement") is NOT a string the kernel recognises
+   without the pack (i.e., it must register a new space type).
+3. None of the kernel modules import anything from
+   ``arqux.domains.procurement``.
+
+Phase 0/1/2 are sufficient to assert (1) and (3). (2) will become
+stronger when the loader exists in Phase 9 — for now we verify the
+manifest-level separation.
+"""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+from arqux.domains.procurement import MANIFEST as PROCUREMENT_MANIFEST
+from arqux.spi import SPI_API_VERSION, conformity_suite
+
+
+def test_procurement_manifest_conforms():
+    failures = conformity_suite(PROCUREMENT_MANIFEST)
+    assert failures == [], f"procurement manifest fails conformity: {failures}"
+
+
+def test_procurement_targets_current_spi_api_version():
+    assert PROCUREMENT_MANIFEST.api_version == SPI_API_VERSION
+
+
+def test_kernel_does_not_import_procurement_domain():
+    """Static check: no file under src/arqux/kernel/ imports from
+    arqux.domains.procurement. Run as an AST walk to avoid
+    accidentally importing the domain during collection.
+    """
+    kernel_dir = Path(__file__).resolve().parents[2] / "src" / "arqux" / "kernel"
+    assert kernel_dir.is_dir(), f"kernel dir not found: {kernel_dir}"
+
+    offenders: list[str] = []
+    for py in kernel_dir.rglob("*.py"):
+        tree = ast.parse(py.read_text(encoding="utf-8"))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.ImportFrom):
+                if (node.module or "").startswith("arqux.domains.procurement"):
+                    offenders.append(f"{py}:{node.lineno}: from {node.module}")
+            elif isinstance(node, ast.Import):
+                for alias in node.names:
+                    if (alias.name or "").startswith("arqux.domains.procurement"):
+                        offenders.append(f"{py}:{node.lineno}: import {alias.name}")
+    assert not offenders, (
+        "kernel files import procurement domain — violates ADR-001:\n"
+        + "\n".join(offenders)
+    )
+
+
+def test_software_manifest_conforms():
+    from arqux.domains.software import MANIFEST as SOFTWARE_MANIFEST
+
+    failures = conformity_suite(SOFTWARE_MANIFEST)
+    assert failures == [], f"software manifest fails conformity: {failures}"
+
+
+def test_software_targets_current_spi_api_version():
+    from arqux.domains.software import MANIFEST as SOFTWARE_MANIFEST
+
+    assert SOFTWARE_MANIFEST.api_version == SPI_API_VERSION
+
+
+def test_kernel_does_not_import_software_domain():
+    kernel_dir = Path(__file__).resolve().parents[2] / "src" / "arqux" / "kernel"
+    offenders: list[str] = []
+    for py in kernel_dir.rglob("*.py"):
+        tree = ast.parse(py.read_text(encoding="utf-8"))
+        for node in ast.walk(tree):
+            if isinstance(node, ast.ImportFrom):
+                if (node.module or "").startswith("arqux.domains.software"):
+                    offenders.append(f"{py}:{node.lineno}: from {node.module}")
+            elif isinstance(node, ast.Import):
+                for alias in node.names:
+                    if (alias.name or "").startswith("arqux.domains.software"):
+                        offenders.append(f"{py}:{node.lineno}: import {alias.name}")
+    assert not offenders, (
+        "kernel files import software domain — violates ADR-001:\n"
+        + "\n".join(offenders)
+    )
diff --git a/tests/invariants/test_invariant_12_contract_freeze_canonical.py b/tests/invariants/test_invariant_12_contract_freeze_canonical.py
new file mode 100644
