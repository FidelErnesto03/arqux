# -- $0: MINIMAL LOCAL GLOSSARY --
# Sigil | Name | Type | Risk | Cognitive Layer | Description
# AXM   | axiom      | attrs      | H | Prefrontal     | Project behavioral axiom
# ARQX  | artifact   | attrs      | B | Semantic       | Artifact metadata (in $1)
# IDN   | identity   | attrs      | B | Semantic       | Actor identity
# DOM   | domain     | attrs      | B | Semantic       | Project/scope descriptor
# KNW   | knowledge  | attrs      | B | Semantic       | Stable knowledge
# RSK   | risk       | attrs      | M | Prefrontal     | Risk with mitigation
# FCS   | focus      | attrs      | H | Working        | Active attention anchor
# OBJ   | objective  | attrs      | H | Working        | Standing objective
# WRK   | work       | attrs      | B | Working        | Current execution state
# HND   | handoff    | attrs      | M | Episodic       | Pending handoff (state, not file)
# LNG   | lesson     | attrs      | M | Episodic       | Learned lesson
# LOOP  | loop       | attrs      | B | Working        | Autonomous loop declaration
# SES   | session    | attrs      | M | Episodic       | Compressed session record
# AUD   | audit      | attrs      | M | Episodic       | Session event (lives in timelog $5 EVENTS)
# DEC   | decision   | attrs      | M | Episodic       | Session decision (lives in timelog)
# ERR   | error      | attrs      | M | Episodic       | Session error (lives in timelog)
#
# Types:
# attrs = canonical type
# cuerpo = canonical type
#
# Micro-glossary:
# cur=current wrk=work min=minimum ok=success
#
# GRADIENT-12 layout: $1 IDENTITY | $2 AXIOMS | $3 KNOWLEDGE | $4 RISKS |
# $5 FOCUS | $6 OBJECTIVES | $7 ACTIVE_CONTEXT | $8 LESSONS | $9 LOOPS |
# $10 SESSIONS. Events live in .arqux/timelog/<SES>/… $5 EVENTS.


$1: IDENTITY

ARQX:artifact{level:2, name:"__PROJECT__", usage:"state", kind:"native", version:"0", revision:"0", last_writer:"__GOVERNOR__"}

IDN:project{name:"__PROJECT__", product:"__PROJECT__", version:"0.1.0", purpose:"New governed project"}

IDN:governor{name:"__GOVERNOR__", level:"governor", project:"__PROJECT__"}

DOM:scope{name:"__PROJECT__", area:"__PROJECT__", purpose:"Governed project workspace"}


$2: AXIOMS

# Project behavioral axioms — mandated by the Architect or elevated by
# forced learning. Recommended: severity:"blocking", survive:"min".
# AXM:<name>{rule:"...", severity:"blocking", survive:"min"}


$3: KNOWLEDGE


$4: RISKS


$5: FOCUS

FCS:current{name:"bootstrap", what:"Initial governance bootstrap of __PROJECT__", priority:"high", status:"current", survive:"work"}


$6: OBJECTIVES

OBJ:onboard{name:"onboarding", goal:"Complete project onboarding: populate brain sections, open first cycle", status:"current", success:"brain valid and first cycle open", survive:"work"}


$7: ACTIVE_CONTEXT

WRK:current{name:"init", phase:"init", current:"project initialized - pending brain population", blocked:"no", survive:"work"}


$8: LESSONS


$9: LOOPS


$10: SESSIONS
