{
  "name": "arqux-cortex-viewer",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.4.3",
  "publisher": "arqux",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FidelErnesto03/arqux",
    "directory": "extensions/cortex-viewer"
  },
  "bugs": {
    "url": "https://github.com/FidelErnesto03/arqux/issues"
  },
  "homepage": "https://github.com/FidelErnesto03/arqux",
  "categories": [
    "Programming Languages",
    "Visualization",
    "Formatters"
  ],
  "keywords": [
    "cortex",
    "hcortex",
    "c14n",
    "codec",
    "arqux"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cortex"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cortex",
        "aliases": [
          "CORTEX",
          "cortex"
        ],
        "extensions": [
          ".cortex"
        ],
        "configuration": "./language-configuration.json",
        "semanticTokenScopes": [
          {
            "language": "cortex",
            "scopes": {
              "type": [
                "entity.name.type"
              ],
              "enumMember": [
                "variable.other.enummember"
              ],
              "namespace": [
                "entity.name.namespace"
              ],
              "macro": [
                "keyword.other.directive"
              ]
            }
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "cortex",
        "scopeName": "source.cortex",
        "path": "./syntaxes/cortex.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cortex.openPreview",
        "title": "%cmd.openPreview%",
        "category": "CORTEX",
        "icon": "$(open-preview)"
      },
      {
        "command": "cortex.openPreviewToSide",
        "title": "%cmd.openPreviewToSide%",
        "category": "CORTEX",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "cortex.verifyHash",
        "title": "%cmd.verifyHash%",
        "category": "CORTEX",
        "icon": "$(shield)"
      },
      {
        "command": "cortex.applyHumanEdit",
        "title": "%cmd.applyHumanEdit%",
        "category": "CORTEX",
        "icon": "$(edit)"
      },
      {
        "command": "cortex.exportPreview",
        "title": "%cmd.exportPreview%",
        "category": "CORTEX",
        "icon": "$(export)"
      },
      {
        "command": "cortex.statusMenu",
        "title": "%cmd.statusMenu%",
        "category": "CORTEX",
        "icon": "$(info)"
      },
      {
        "command": "cortex.validateWorkspace",
        "title": "%cmd.validateWorkspace%",
        "category": "CORTEX",
        "icon": "$(checklist)"
      }
    ],
    "keybindings": [
      {
        "command": "cortex.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == 'cortex'"
      },
      {
        "command": "cortex.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == 'cortex'"
      }
    ],
    "snippets": [
      {
        "language": "cortex",
        "path": "./snippets/cortex.json"
      }
    ],
    "configuration": {
      "title": "ArqUX CORTEX Viewer",
      "properties": {
        "cortex.toolchainPath": {
          "type": "string",
          "default": "",
          "description": "%cfg.toolchainPath%"
        },
        "cortex.debounceMs": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "description": "%cfg.debounceMs%"
        },
        "cortex.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.formatOnSave%"
        },
        "cortex.inlineDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.inlineDiagnostics%"
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "cortex.openPreview",
          "when": "editorLangId == 'cortex'",
          "group": "navigation"
        },
        {
          "command": "cortex.openPreviewToSide",
          "when": "editorLangId == 'cortex'",
          "group": "navigation"
        },
        {
          "command": "cortex.exportPreview",
          "when": "editorLangId == 'cortex'",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "cortex.verifyHash",
          "when": "editorLangId == 'cortex'",
          "group": "cortex"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ --noEmit && npm run esbuild",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "mocha --timeout 30000 out/test/suite/*.js",
    "lint": "tsc -p ./ --noEmit",
    "esbuild": "esbuild src/extension.ts src/server/server.ts src/test/suite/extension.test.ts --bundle --outbase=src --outdir=out --external:vscode --format=cjs --platform=node --sourcemap"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.2",
    "mocha": "^10.8.2",
    "typescript": "~5.6.3",
    "markdown-it": "^14.1.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
